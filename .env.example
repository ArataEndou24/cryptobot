# このファイルを .env という名前でコピーし、値を埋めてください。
# .env は git に含まれません（.gitignore で除外済み）。

# Hyperliquid の取引専用ウォレット（API ウォレット）の秘密鍵。
# 出金権限のない取引専用の鍵だけをここに置きます。メインウォレットの鍵は絶対に置かないでください。
HL_API_WALLET_PRIVATE_KEY=

# メインウォレット（資金を預けている口座）のアドレス。秘密鍵ではなく公開アドレスです。
HL_MAIN_ADDRESS=

# Telegram 通知（任意）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
